# Go 后端镜像：多阶段构建，最终只带一个静态二进制。
# 构建上下文是仓库根目录，因此 COPY 路径以 backend/ 开头：
#   docker build -f deploy/Dockerfile.backend -t inspection-api .
FROM golang:1.23-alpine AS build

WORKDIR /src
COPY backend/go.mod ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/inspection-api ./cmd/server

FROM alpine:3.20

RUN adduser -D -H -u 10001 app \
    && mkdir -p /data \
    && chown app:app /data

COPY --from=build /out/inspection-api /usr/local/bin/inspection-api

USER app
WORKDIR /data
ENV ADDR=":8080" \
    DATA_FILE="/data/issues.json"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["inspection-api"]
